end)

-- ==========================================
-- LÓGICA DO AUTO FARM
-- ==========================================
local farmAtivo = false
local loopFarm = nil

local function procurarDoce()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPos = char.HumanoidRootPart.Position
    local doceMaisProximo = nil
    local menorDist = math.huge

    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Candy Corn" or v.Name == "CandyCorn" or v.Name == "Candy_Corn" then
            local pos = nil
            if v:IsA("BasePart") then
                pos = v.Position
            elseif v.PrimaryPart then
                pos = v.PrimaryPart.Position
            elseif v:FindFirstChildWhichIsA("BasePart") then
                pos = v:FindFirstChildWhichIsA("BasePart").Position
            end

            if pos then
                local dist = (rootPos - pos).Magnitude
                if dist < menorDist then
                    menorDist = dist
                    doceMaisProximo = v
                end
            end
        end
    end
    return doceMaisProximo
end

local function loop()
    while farmAtivo do
        local char = LP.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local doce = procurarDoce()
            
            if doce then
                local posFinal = nil
                if doce:IsA("BasePart") then
                    posFinal = doce.Position
                elseif doce.PrimaryPart then
                    posFinal = doce.PrimaryPart.Position
                elseif doce:FindFirstChildWhichIsA("BasePart") then
                    posFinal = doce:FindFirstChildWhichIsA("BasePart").Position
                end

                if posFinal then
                    -- Teleporta (um pouco mais alto pra garantir o hitbox)
                    char.HumanoidRootPart.CFrame = CFrame.new(posFinal + Vector3.new(0, 3, 0))
                    
                    -- Espera um pouquinho pra física processar o toque
                    task.wait(0.15) 
                    
                    -- Verifica se o doce sumiu (foi coletado)
                    -- Se não sumiu em 0.5 segundos, ele força a próxima busca de qualquer forma
                    local tempoEspera = 0
                    while doce.Parent ~= nil and tempoEspera < 0.5 do
                        task.wait(0.05)
                        tempoEspera = tempoEspera + 0.05
                    end
                end
            else
                -- Se não tem doce no mapa, espera um pouco e tenta de novo
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
        task.wait() -- Cede um frame pro jogo não travar
    end
end

btnFarm.MouseButton1Click:Connect(function()
    farmAtivo = not farmAtivo
    if farmAtivo then
        btnFarm.Text = "AUTO FARM: ON"
        btnFarm.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
        if not loopFarm or loopFarm.Status == Enum.Status.Suspended or loopFarm.Status == Enum.Status.Dead then
            loopFarm = task.spawn(loop)
        end
    else
        btnFarm.Text = "AUTO FARM: OFF"
        btnFarm.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end
end)